# --- Inngest ---
# Local dev: talk to the Inngest dev server (v4 defaults to cloud mode).
INNGEST_DEV=1
# Production (Inngest Cloud). The Vercel integration sets these for you.
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- Alarm ---
# filming: 8s start delay, 20s ring timeout, 4s snooze. real: 0s, 2m, 9m.
# Applies to the 6am cron and to events without overrides. Unset = real.
ALARM_MODE=filming

# --- Integrations ---
# Everything is mocked unless ALL vars for that integration are set.

# Email (apology to team + manager) via Resend
# RESEND_API_KEY=
# RESEND_FROM="Angry Alarm <alarm@yourdomain.com>"
# TEAM_EMAIL=
# MANAGER_EMAIL=

# Slack #general via incoming webhook
# SLACK_WEBHOOK_URL=

# Text Mum via Twilio. Leave unset unless you really mean it.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# MUM_PHONE=

# X post and calendar rename are mock-only.
